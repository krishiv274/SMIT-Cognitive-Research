# Copy to .env and change BEFORE collecting real data.
# Researcher dashboard password
SMIT_ADMIN_PASSWORD=change-me-now
# Random secret used to sign researcher tokens (e.g. python3 -c "import secrets; print(secrets.token_hex(32))")
SMIT_SECRET_KEY=dev-secret-change-me
# Random pepper used to hash emails for duplicate detection (never change after data collection starts)
SMIT_EMAIL_PEPPER=change-this-pepper
# Where the SQLite database and generated outputs are stored (default: ./data)
# SMIT_DATA_DIR=/absolute/path/to/data
# Optional PostgreSQL instead of SQLite (requires: pip install psycopg[binary])
# SMIT_DATABASE_URL=postgresql+psycopg://smit:password@localhost:5432/smit
# Token lifetime for researcher logins (hours)
SMIT_TOKEN_TTL_HOURS=12
# Maximum upload size (MB)
SMIT_MAX_UPLOAD_MB=15
# Never set to true outside automated tests
SMIT_ALLOW_SYNTHETIC_IMPORTS=false
# Participants must pass the computer check (Mac, Google Chrome, power saving off) before the test.
# Never set to false for real data collection (only automated tests turn it off)
SMIT_REQUIRE_DEVICE_CHECK=true
